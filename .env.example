POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radarstock

DATABASE_URL=postgres://radar:radar@localhost:5432/radarstock

# Segredo compartilhado entre web e api (header x-internal-secret)
INTERNAL_SECRET=troque-este-segredo-interno-radarstock-32c

# Cookie de sessão (iron-session exige string longa)
SESSION_SECRET=troque-este-segredo-de-sessao-radarstock-32c

# Opcional: sobrescreve o admin criado no seed
ADMIN_SEED_EMAIL=admin@radarstock.local
ADMIN_SEED_PASSWORD=Admin123!
